extends Node
## Sound effects and music. Effects come from a small pool of players and
## the same sound can't restart more often than MIN_GAP, so hundreds of hits
## per second don't turn into noise. Files live in res://assets/audio and are
## generated by tools/gen_audio.py.

const DIR := "res://assets/audio/"
const POOL_SIZE := 16
const MIN_GAP := 0.03
const MUSIC_DB := -9.0

var _streams: Dictionary = {}
var _players: Array[AudioStreamPlayer] = []
var _next := 0
var _last_played: Dictionary = {}
var _music: AudioStreamPlayer
var _music_name := ""
var _fade: Tween


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_ensure_bus("Music")
	_ensure_bus("SFX")
	for i in POOL_SIZE:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_players.append(p)
	_music = AudioStreamPlayer.new()
	_music.volume_db = MUSIC_DB
	_music.bus = "Music"
	add_child(_music)
	Settings.apply_audio()


## Adds a bus routed into Master if it doesn't exist yet.
func _ensure_bus(bus_name: String) -> void:
	if AudioServer.get_bus_index(bus_name) >= 0:
		return
	AudioServer.add_bus()
	var idx := AudioServer.bus_count - 1
	AudioServer.set_bus_name(idx, bus_name)
	AudioServer.set_bus_send(idx, "Master")


## Plays a sound effect by file name (without extension).
func play(sound: String, volume_db: float = 0.0, pitch_jitter: float = 0.06) -> void:
	var now := Time.get_ticks_msec() / 1000.0
	if now - float(_last_played.get(sound, -1.0)) < MIN_GAP:
		return
	_last_played[sound] = now
	var stream := _stream(sound)
	if stream == null:
		return
	var p := _players[_next]
	_next = (_next + 1) % POOL_SIZE
	p.stream = stream
	p.volume_db = volume_db
	p.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	p.play()


## Loops a music track; does nothing if it is already playing.
func play_music(track: String) -> void:
	if track == _music_name and _music.playing:
		return
	var stream := _stream(track) as AudioStreamWAV
	if stream == null:
		return
	stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
	stream.loop_begin = 0
	stream.loop_end = int(stream.get_length() * stream.mix_rate)
	_music_name = track
	_music.stream = stream
	if _fade == null or not _fade.is_running():
		_music.volume_db = MUSIC_DB
	_music.play()


func _exit_tree() -> void:
	# Release streams so nothing is still referenced when the game quits.
	_music.stop()
	_music.stream = null
	for p in _players:
		p.stop()
		p.stream = null
	_streams.clear()


## Fades the current music out and `track` in (e.g. when night falls).
func crossfade_music(track: String, seconds: float = 2.0) -> void:
	if track == _music_name:
		return
	if _fade != null and _fade.is_valid():
		_fade.kill()
	_fade = create_tween()
	_fade.tween_property(_music, "volume_db", -40.0, seconds * 0.5)
	_fade.tween_callback(func() -> void: play_music(track))
	_fade.tween_property(_music, "volume_db", MUSIC_DB, seconds * 0.5)


## Holds the music (e.g. during the angel's rescue) and picks it up again.
func pause_music(on: bool) -> void:
	_music.stream_paused = on


func stop_music() -> void:
	_music.stop()
	_music_name = ""


func _stream(sound: String) -> AudioStream:
	if not _streams.has(sound):
		var path := DIR + sound + ".wav"
		_streams[sound] = load(path) if ResourceLoader.exists(path) else null
	return _streams[sound]
